# Florida Southeast Realty — environment variables
# Copy to .env.local for local development or add the required values in Vercel.
# Never commit real API keys or secrets.

# --- Lead delivery (app/api/lead/route.ts) ---
# Configure ONE delivery method before public launch.

# Option A: POST every lead as JSON to a CRM / automation webhook.
LEAD_WEBHOOK_URL=

# Option B: transactional lead email via Resend.
RESEND_API_KEY=
RESEND_TO_EMAIL=roque@floridasoutheastrealty.com
RESEND_FROM_EMAIL=

# --- BeachesMLS / IDX (lib/idx.ts) ---
# Add credentials only after the broker data license / API access is approved.
IDX_PROVIDER_BASE_URL=
IDX_PROVIDER_API_KEY=
IDX_MLS_DISCLAIMER_TEXT=

# Optional: explicitly allow demonstration inventory outside local/preview environments.
# Keep FALSE for public production.
NEXT_PUBLIC_ENABLE_SAMPLE_DATA=false

# --- Google / measurement ---
# GA4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML verification token (content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.floridasoutheastrealty.com
