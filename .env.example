# Florida Southeast Realty — environment variables
# Copy to .env.local for local development or add the required values in Vercel.
# Never commit real API keys or secrets.

# --- Lead delivery (app/api/lead/route.ts) ---
# Configure ONE delivery method before public launch.

# Option A: POST every lead as JSON to a CRM / automation webhook.
LEAD_WEBHOOK_URL=

# Option B: transactional lead email via Resend.
RESEND_API_KEY=
RESEND_TO_EMAIL=roque@floridasoutheastrealty.com
RESEND_FROM_EMAIL=

# Required before sending property-alert texts. Keep blank to use email alerts only.
SMS_ALERT_WEBHOOK_URL=

# --- Private CRM (Supabase) ---
# Public values (modern and legacy Vercel/Supabase integration names are supported).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Either name works; never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRM_ADMIN_EMAILS=roque@floridasoutheastrealty.com

# --- BeachesMLS / RESO Web API (lib/idx.ts) ---
# Server-only, non-expiring access token. Never prefix this with NEXT_PUBLIC_.
RESO_ACCESS_TOKEN=
RESO_API_BASE_URL=https://replication.sparkapi.com/Version/3/Reso/OData
IDX_MLS_NAME=BeachesMLS
IDX_ORIGINATING_SYSTEM_ID=M00000170
IDX_MLS_DISCLAIMER_TEXT=

# Legacy aliases remain supported so the existing Vercel token keeps working.
SPARK_ACCESS_TOKEN=
SPARK_API_BASE_URL=
IDX_PROVIDER_BASE_URL=
IDX_PROVIDER_API_KEY=

# Optional: explicitly allow demonstration inventory outside local/preview environments.
# Keep FALSE for public production.
NEXT_PUBLIC_ENABLE_SAMPLE_DATA=false

# --- Google / measurement ---
# GA4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML verification token (content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.floridasoutheastrealty.com
